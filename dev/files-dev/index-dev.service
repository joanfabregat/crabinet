[Unit]
Description=Index Preact development server
Wants=network-online.target
After=network-online.target user@1001.service traefik.service index-dev-backend.service
Requires=user@1001.service index-dev-backend.service
RequiresMountsFor=/home/joan/repos/index/web /home/joan/repos/index/.git /home/joan/repos/index/dev/files-dev /data/index-dev/build/node_modules /etc/index-dev

[Service]
Type=notify
NotifyAccess=all
User=joan
Group=joan
Environment=HOME=/home/joan
Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
SyslogIdentifier=index-dev
UMask=0077
MemoryMax=512M
MemorySwapMax=512M
TasksMax=128
OOMPolicy=kill
IPAddressDeny=169.254.0.0/16
IPAddressDeny=fd20:ce::254/128

ExecStartPre=-/usr/bin/podman rm --volumes --force --ignore index-dev
ExecStartPre=/usr/bin/podman network create --ignore index-dev
ExecStart=/usr/bin/podman run \
  --name=index-dev \
  --replace \
  --rm \
  --cgroups=disabled \
  --pull=never \
  --sdnotify=conmon \
  --detach \
  --network=index-dev \
  --userns=keep-id:uid=65532,gid=65532 \
  --user=65532:65532 \
  --security-opt=no-new-privileges \
  --cap-drop=all \
  --read-only \
  --tmpfs=/tmp:size=128m,mode=1777 \
  --workdir=/workspace \
  --volume=/home/joan/repos/index/web:/workspace:ro \
  --volume=/home/joan/repos/index/.git:/repo-git:ro \
  --volume=/data/index-dev/build/node_modules:/workspace/node_modules:ro \
  --volume=/home/joan/repos/index/dev/files-dev/frontend-start.sh:/usr/local/bin/index-dev-frontend:ro \
  --volume=/home/joan/repos/index/dev/files-dev/package-lock.sha256:/etc/index-dev/package-lock.sha256:ro \
  --publish=127.0.0.1:18081:5173 \
  --env=HOME=/tmp \
  --env=INDEX_DEV_BACKEND_URL=http://index-dev-backend:8080 \
  --env=INDEX_DEV_PUBLIC_HOST=files-dev.jf.ffwip.com \
  --env=INDEX_DEV_GIT_DIR=/repo-git \
  --env=INDEX_VITE_CACHE_DIR=/tmp/vite-cache \
  --label=traefik.enable=true \
  --label=traefik.http.routers.index-dev.rule=Host(`files-dev.jf.ffwip.com`) \
  --label=traefik.http.routers.index-dev.entrypoints=websecure \
  --label=traefik.http.routers.index-dev.service=index-dev \
  --label=traefik.http.services.index-dev.loadbalancer.server.port=5173 \
  --label=traefik.http.services.index-dev.loadbalancer.healthcheck.path=/health/ready \
  --label=traefik.http.services.index-dev.loadbalancer.healthcheck.interval=10s \
  --label=traefik.http.services.index-dev.loadbalancer.healthcheck.timeout=5s \
  docker.io/library/node:24-bookworm-slim@sha256:713cfbf4a0ac19f40e1bb9919893e126b74a5c8cf5d0623c9f89515c8f74c6fa \
  /bin/sh /usr/local/bin/index-dev-frontend

ExecStartPost=/usr/bin/curl --fail --silent --show-error --retry 120 --retry-all-errors --retry-delay 1 http://127.0.0.1:18081/health/ready
ExecStop=/usr/bin/podman rm --volumes --force --ignore index-dev
ExecStopPost=-/usr/bin/podman rm --volumes --force --ignore index-dev

Restart=on-failure
RestartSec=2s
TimeoutStartSec=600s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
