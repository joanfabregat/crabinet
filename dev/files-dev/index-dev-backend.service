[Unit]
Description=Index watched Rust development backend
Wants=network-online.target
After=network-online.target user@1001.service
Requires=user@1001.service
RequiresMountsFor=/home/joan/repos/index /home/joan/repos/index/dev/files-dev /data/services/index-dev/build/target /etc/index-dev /data/services/index-dev/state /data/services/index-dev/shares

[Service]
Type=notify
NotifyAccess=all
User=joan
Group=joan
Environment=HOME=/home/joan
Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
SyslogIdentifier=index-dev-backend
UMask=0077
MemoryMax=3G
MemorySwapMax=3G
TasksMax=512
OOMPolicy=kill
IPAddressDeny=169.254.0.0/16
IPAddressDeny=fd20:ce::254/128

ExecStartPre=-/usr/bin/podman rm --volumes --force --ignore index-dev-backend
ExecStartPre=/usr/bin/podman network create --ignore index-dev
ExecStart=/usr/bin/podman run \
  --name=index-dev-backend \
  --replace \
  --rm \
  --cgroups=disabled \
  --pull=never \
  --sdnotify=conmon \
  --detach \
  --network=index-dev \
  --network-alias=index-dev-backend \
  --userns=keep-id:uid=65532,gid=65532 \
  --user=65532:65532 \
  --security-opt=no-new-privileges \
  --cap-drop=all \
  --read-only \
  --tmpfs=/tmp:size=256m,mode=1777 \
  --workdir=/workspace \
  --volume=/home/joan/repos/index:/workspace:ro \
  --volume=/data/services/index-dev/build/target:/workspace/target:rw \
  --volume=/home/joan/.cache/dev-vm-podman/cargo:/cargo-cache:rw \
  --volume=/data/services/index-dev/shares/repos:/shares/repos:rw \
  --volume=/data/services/index-dev/shares/scratch:/shares/scratch:rw \
  --volume=/etc/index-dev/config.toml:/etc/index/config.toml:ro \
  --volume=/etc/index-dev/session.key:/run/secrets/index/session.key:ro \
  --volume=/data/services/index-dev/state:/var/lib/index:rw \
  --volume=/home/joan/repos/index/dev/files-dev/backend-watch.sh:/usr/local/bin/index-dev-backend:ro \
  --volume=/home/joan/repos/index/dev/files-dev/Cargo.lock.sha256:/etc/index-dev/Cargo.lock.sha256:ro \
  --publish=127.0.0.1:18082:8080 \
  --env=HOME=/tmp \
  --env=CARGO_HOME=/cargo-cache \
  --env=CARGO_TARGET_DIR=/workspace/target \
  --env=CARGO_BUILD_JOBS=4 \
  --env=RUST_LOG=index=debug \
  docker.io/library/rust:1.90-bookworm@sha256:3f6e6f8d8725a65a2db964bb828850f888d430c68784d661f753144e5d787207 \
  /bin/bash /usr/local/bin/index-dev-backend

ExecStartPost=/usr/bin/curl --fail --silent --show-error --retry 300 --retry-all-errors --retry-delay 1 http://127.0.0.1:18082/health/ready
ExecStop=/usr/bin/podman rm --volumes --force --ignore index-dev-backend
ExecStopPost=-/usr/bin/podman rm --volumes --force --ignore index-dev-backend

Restart=on-failure
RestartSec=2s
TimeoutStartSec=600s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
